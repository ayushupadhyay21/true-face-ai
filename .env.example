# Copy to .env and fill in local values. Never commit .env.
# Any setting in backend/app/core/config.py can be overridden here (upper-case name).

# PostgreSQL (local only). The application role is created by scripts/setup_database.py.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=face_liveness_research
POSTGRES_USER=face_research
POSTGRES_PASSWORD=change_me

# Model directory defaults to <project>/models. If overridden, use an ABSOLUTE path.
# MODELS_DIR=D:/path/to/models

# Inference (no CUDA GPU on the audit machine)
ONNX_PROVIDERS=CPUExecutionProvider

# Privacy: raw camera frames are never written to disk
STORE_RAW_FRAMES=false

# Liveness mode: false = passive only (automatic, no user instructions);
# true = passive + random head-turn/blink challenge (stronger against video replay)
ACTIVE_LIVENESS_ENABLED=true

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200
