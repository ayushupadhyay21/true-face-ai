# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL (local only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=face_liveness_research
POSTGRES_USER=face_research
POSTGRES_PASSWORD=change_me

# Paths
MODELS_DIR=./models
DATASETS_DIR=./datasets

# Inference (no CUDA GPU on the audit machine)
ONNX_PROVIDERS=CPUExecutionProvider

# Privacy: raw camera frames are discarded after processing unless enabled
STORE_RAW_FRAMES=false

# Logging
LOG_LEVEL=INFO
